# Copy to .env for local development. NEVER commit .env (handbook/SECURITY.md §7).
# Values here are placeholders that only work on your own machine.

# --- Shared --------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
SITE_URL=http://localhost:3000      # canonical public URL (production: https://empirebuildcon.com)

# --- API and worker (apps/api) -------------------------------------------
DATABASE_URL=postgresql+psycopg://empire:empire@localhost:5432/empire_dev
SESSION_SECRET=change-me-to-32-or-more-random-bytes-base64
DATA_ENCRYPTION_KEY=change-me-fernet-key-from-empire-api-gen-key
INTERNAL_API_KEY=change-me-long-random-string
IP_HASH_SALT=change-me-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:3000   # development only; empty in production (same-origin proxy)
SENTRY_DSN_API=
CLOUDINARY_URL=                     # cloudinary://<api_key>:<api_secret>@<cloud_name>; required in staging/production
MEDIA_STORE=                        # cloudinary | fake; empty = cloudinary when CLOUDINARY_URL is set, else fake (dev/test only)
MEDIA_DEV_DIR=                      # fake store's folder; empty = apps/api/.media-dev/ (git-ignored)
EMAIL_API_KEY=                      # Resend API key (re_…); required in staging/production; never logged or shown
EMAIL_FROM=                         # plain sender address on a domain verified at Resend, e.g. alerts@empirebuildcon.com; required in staging/production
EMAIL_TRANSPORT=                    # resend | dev; empty = resend when EMAIL_API_KEY is set, else dev (never sends; dev/test only)
MAIL_DEV_DIR=                       # dev transport's folder; empty = apps/api/.mail-dev/ (git-ignored)

# --- Web proxy ↔ API trust (empty locally; required in staging and production) ----
EDGE_PROXY_KEY=                     # same random value on the web host and the API host (empire-api gen-secrets)
CLIENT_IP_SOURCE_HEADER=x-nf-client-connection-ip   # web host header with the visitor's IP (Netlify)

# --- Web (apps/web) --------------------------------------------------------
API_ORIGIN=http://localhost:8000    # where Next.js rewrites /api/* to
WEB_REVALIDATE_URL=                 # http://localhost:3000/_internal/revalidate; required in staging and production
REVALIDATE_SECRET=change-me-long-random-string   # also signs redirect hit counts sent to the API (task 5.6)
REDIRECT_CACHE_SECONDS=             # optional; how long the website keeps the CMS redirects (default 60)
ALLOW_INDEXING=                         # TODO(phase-9): set true in production only to allow search crawlers (task 5.6b)
NEXT_PUBLIC_SENTRY_DSN=
