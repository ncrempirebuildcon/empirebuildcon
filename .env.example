# Copy to .env for local development. NEVER commit .env (handbook/SECURITY.md §7).
# Values here are placeholders that only work on your own machine.

# --- Shared --------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
SITE_URL=http://localhost:3000      # canonical public URL (production: https://empirebuildcon.com)

# --- API and worker (apps/api) -------------------------------------------
DATABASE_URL=postgresql+psycopg://empire:empire@localhost:5432/empire_dev
SESSION_SECRET=change-me-to-32-or-more-random-bytes-base64
DATA_ENCRYPTION_KEY=change-me-fernet-key-from-empire-api-gen-key
INTERNAL_API_KEY=change-me-long-random-string
IP_HASH_SALT=change-me-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:3000   # development only; empty in production (same-origin proxy)
SENTRY_DSN_API=
CLOUDINARY_URL=                     # Phase 4
EMAIL_API_KEY=                      # Phase 4 (Resend)

# --- Web proxy ↔ API trust (empty locally; required in staging and production) ----
EDGE_PROXY_KEY=                     # same random value on the web host and the API host (empire-api gen-secrets)
CLIENT_IP_SOURCE_HEADER=x-nf-client-connection-ip   # web host header with the visitor's IP (Netlify)

# --- Web (apps/web) --------------------------------------------------------
API_ORIGIN=http://localhost:8000    # where Next.js rewrites /api/* to
REVALIDATE_SECRET=change-me-long-random-string
NEXT_PUBLIC_SENTRY_DSN=
